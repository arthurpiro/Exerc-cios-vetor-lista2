#include <stdio.h>

int main(){
    int idade[5];
    int contador;
    int soma = 0;
    int maiorIdade;
    int menorIdade;
    int mediaIdade;

    for(contador=0; contador<5; contador++){
        printf("Escreva sua idade: ");
        scanf("%d", &idade[contador]);
        soma = soma + idade[contador];
    }

    maiorIdade = idade[0];
    menorIdade = idade[0];

    for(contador=1; contador<5; contador++){
        if(idade[contador] > maiorIdade){
            maiorIdade = idade[contador];
        }
        if(idade[contador] < menorIdade){
            menorIdade = idade[contador]
        }
    }

    mediaIdade = soma / 5;

    printf("A maior idade e: %d\n", maiorIdade);
    printf("A menor idade e: %d\n", menorIdade);
    printf("A media da idade e: %d\n", mediaIdade);

    return 0;
}
